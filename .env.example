# ============================================================
# EllenSings Bot — пример конфигурации
# Скопируй в .env и заполни своими значениями.
# .env в git не попадает (см. .gitignore) — не коммить его!
# ============================================================

# Discord Bot Token (обязательно)
# Получить: https://discord.com/developers/applications
#
# ВАЖНО:
#  - Для production используй ОТДЕЛЬНЫЙ токен (отдельное приложение),
#    не тот, с которым разрабатываешь локально.
#  - При любой утечке токена немедленно перевыпусти его
#    (Developer Portal -> Bot -> Reset Token).
#  - Альтернатива для production: Docker secrets — бот поддерживает
#    переменную DISCORD_TOKEN_FILE с путём к файлу с токеном.
DISCORD_TOKEN=your_discord_bot_token_here

# ============================================================
# Прокси (gateway-контейнер: tun2socks + kill-switch)
# ============================================================
# ТРЕБОВАНИЕ: SOCKS5-прокси должен поддерживать UDP ASSOCIATE,
# иначе Discord Voice (UDP) не заработает. В sing-box это
# socks-inbound (UDP включён по умолчанию).
#
# Xray на хосте слушает только gateway выделенной Docker-сети:
#   172.29.0.1:10812
# Это не открывает SOCKS inbound в LAN или интернет.
#
# Форматы:
#   socks5://host:port
#   socks5://user:pass@host:port
#
# URL с логином/паролем в логи не выводится.
PROXY_URL=socks5://172.29.0.1:10812

# ============================================================
# Docker-образы (для деплоя через registry)
# ============================================================
# Если собираешь локально — оставь закомментированным.
# Если тянешь готовые образы с registry:
#BOT_IMAGE=ghcr.io/youruser/ellensings-bot:latest
#GATEWAY_IMAGE=ghcr.io/youruser/ellensings-gateway:latest

# Часовой пояс контейнеров (опционально)
#TZ=Europe/Moscow
